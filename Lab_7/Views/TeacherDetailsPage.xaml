<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Lab_7.ViewModels"
             x:Class="Lab_7.Views.TeacherDetailsPage"
             Title="{Binding Title}">

    <ContentPage.BindingContext>
        <vm:TeacherDetailsViewModel />
    </ContentPage.BindingContext>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            <Border Stroke="#93c5fd" BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Teacher.FullName}" FontSize="22" FontAttributes="Bold" TextColor="#1e3a8a"/>
                    <BoxView HeightRequest="1" Color="#cbd5e1"/>

                    <Grid ColumnDefinitions="120, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Посада:" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Teacher.Position.PositionName}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Телефон:" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Teacher.Phone}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Місце роботи:" FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Teacher.Workplace}" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Адреса:" FontAttributes="Bold" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding Teacher.HomeAddress}" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Характеристика:" FontAttributes="Bold" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding Teacher.Characteristic}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Дисципліни:" FontSize="18" FontAttributes="Bold" TextColor="#1e3a8a" Margin="0,10,0,0"/>

            <CollectionView ItemsSource="{Binding Teacher.TeacherSubjects}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,3" BackgroundColor="#f8fafc" Stroke="#cbd5e1" StrokeShape="RoundRectangle 6">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="•" FontAttributes="Bold" TextColor="#0284c7"/>
                                <Label Text="{Binding Subject.SubjectName}" FontAttributes="Bold" />
                                <Label Text="{Binding HoursRead, StringFormat='({0} год)'}" TextColor="#64748b" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>